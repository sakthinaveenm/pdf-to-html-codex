{
 "name": "multilingual-pdf-workspace",
 "version": "0.1.0",
 "private": true,
 "type": "module",
 "scripts": {
  "dev": "vite --host 127.0.0.1",
  "build:reader": "esbuild ../reader/src/index.ts --bundle --format=iife --target=es2020 --outfile=public/reader.js",
  "build": "npm run build:reader && tsc -b && vite build",
  "test": "vitest run",
  "test:e2e": "playwright test"
 },
 "dependencies": {
  "@tiptap/extension-image": "^3.0.0",
  "@tiptap/extension-table": "^3.0.0",
  "@tiptap/extension-text-style": "^3.32.3",
  "@tiptap/react": "^3.0.0",
  "@tiptap/starter-kit": "^3.0.0",
  "axios": "^1.9.0",
  "pdfjs-dist": "^6.5.438",
  "react": "^19.1.0",
  "react-dom": "^19.1.0",
  "react-router-dom": "^7.6.0"
 },
 "devDependencies": {
  "@playwright/test": "^1.52.0",
  "@types/react": "^19.1.0",
  "@types/react-dom": "^19.1.0",
  "@vitejs/plugin-react": "^4.4.1",
  "esbuild": "^0.25.0",
  "typescript": "^5.8.3",
  "vite": "^6.3.5",
  "vitest": "^5.1.0"
 }
}
